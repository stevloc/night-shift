# Copy to .env for local runs (never commit .env). On Render, set these in Environment instead.
# Leave the SUPABASE_* values empty to run in local demo mode (no sign-in, in-memory data).

# --- AI invoice reading (optional: demo invoices never need it)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# --- Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Nightly run (3:30 AM New York, see docs/nightly-run.md): any long random string
#     (openssl rand -hex 32); the same value goes in the GitHub secret CRON_SECRET
CRON_SECRET=

# "true" shows "Sign in with email". Leave off unless Supabase has custom SMTP (the built-in mailer is rate-limited).
EMAIL_SIGNIN=false

# Optional locally; Render sets PORT itself.
PORT=8000
